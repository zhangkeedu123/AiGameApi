# 复用已有 PostgreSQL 时填写现有连接串。
# 随 Compose 新建 PostgreSQL 时使用主机 db，密码与 JINYAO_DB_PASSWORD 相同并进行 URL 编码。
DATABASE_URL=postgresql://jinyao_app:replace_me@db:5432/jinyao
SESSION_SECRET=replace_with_a_random_secret
COOKIE_SECURE=true
API_LISTEN_HOST=127.0.0.1
API_PORT=8000
API_STATE_DIR=/srv/jinyao/api
PG_DATA_DIR=/srv/jinyao/postgres/data
# 以下两项只在启用 compose.postgres.yaml 时填写。
POSTGRES_PASSWORD=
JINYAO_DB_PASSWORD=
